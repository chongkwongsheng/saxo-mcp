# Copy this file to `.env` and fill in values.
# Get AppKey/AppSecret from: https://www.developer.saxo/openapi/appmanagement#/

SAXO_APP_KEY=
SAXO_APP_SECRET=

# "sim" (default, demo/simulation) or "live" (real money — DO NOT until verified)
SAXO_ENV=sim

# Port for the local OAuth redirect listener. Must match the
# "Redirect URL" registered on your Saxo app: http://localhost:<port>/callback
SAXO_REDIRECT_PORT=52736

# Write-operation gate.
#   blank  = place/cancel/modify tools are NOT registered (default, safest)
#   1      = writes enabled on SIM
#   live-i-mean-it = writes enabled on LIVE (only if SAXO_ENV=live)
SAXO_WRITES_ENABLED=
